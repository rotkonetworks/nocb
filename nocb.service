[Unit]
Description=NOCB Clipboard Manager
# Start once the user session is up, but the daemon does not hard-depend on a
# display: it discovers and waits for X/Wayland at runtime and reconnects across
# X restarts on its own (see ClipboardManager::try_reconnect).
After=default.target
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStart=/usr/bin/nocb daemon
# The daemon pings the watchdog only while it is actually reading the clipboard
# (or actively waiting for X), so "running but deaf" gets restarted.
WatchdogSec=90
Restart=on-failure
RestartSec=2
MemoryMax=256M
CPUQuota=10%

[Install]
WantedBy=default.target
