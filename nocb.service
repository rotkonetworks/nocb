[Unit]
Description=NOCB Clipboard Manager
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/sh -c '\
  if [ -n "$WAYLAND_DISPLAY" ]; then \
    exec /usr/bin/nocb daemon; \
  fi; \
  for i in 0 1 2 3 4 5; do \
    DISPLAY=:$i xdpyinfo >/dev/null 2>&1 && exec env DISPLAY=:$i /usr/bin/nocb daemon; \
  done; \
  sleep 2; exit 1'
Restart=always
RestartSec=2
Environment="XAUTHORITY=%h/.Xauthority"
MemoryMax=256M
CPUQuota=10%
RestartForceExitStatus=1
SuccessExitStatus=0

[Install]
WantedBy=graphical-session.target
